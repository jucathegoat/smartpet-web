# Copie este arquivo para .env e preencha com os seus dados.
# O .env NAO vai para o Git (esta no .gitignore).

server_address=localhost
server_port=8080
jwt_key=troque-esta-chave

# Banco de dados MySQL (Aiven ou local)
db_host=SEU_HOST_AIVEN
db_port=23324
db_user=SEU_USUARIO
db_pass=SUA_SENHA
db_schema=defaultdb
# useSSL para MySQL local, REQUIRED para Aiven
db_ssl=REQUIRED

# Acesso ao painel administrativo
admin_user=adm
admin_password=troque-esta-senha
