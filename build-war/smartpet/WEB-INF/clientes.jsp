<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib uri="jakarta.tags.core" prefix="c" %>
<c:url value="/css/style.css" var="css"/><c:url value="/clientes" var="clientesUrl"/><c:url value="/fila" var="filaUrl"/><c:url value="/loja" var="lojaUrl"/><c:url value="/pets" var="petsUrl"/><c:url value="/avaliacoes" var="avaliacoesUrl"/><c:url value="/logout" var="logoutUrl"/><c:url value="/admin/clientes/salvar" var="saveUrl"/><c:url value="/admin/clientes/excluir" var="deleteUrl"/>
<!doctype html><html lang="pt-br"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Clientes · SmartPet</title><link rel="stylesheet" href="${css}"><style>.grid{display:grid;grid-template-columns:1.5fr 1fr;gap:24px}.card{background:white;padding:20px;border-radius:12px;box-shadow:0 3px 14px #16351a14}.card input{display:block;width:100%;padding:10px;margin:6px 0 12px;border:1px solid #ccd5cc;border-radius:7px;box-sizing:border-box}@media(max-width:850px){.grid{grid-template-columns:1fr}.tabela{display:block;overflow:auto}}</style></head><body>
<header class="navbar"><div class="logo">🐾 SmartPet Admin</div><nav><a href="${filaUrl}">Fila</a><a href="${lojaUrl}">Loja</a><a href="${petsUrl}">Pets</a><a class="active" href="${clientesUrl}">Clientes</a><a href="${avaliacoesUrl}">Avaliações</a><a href="${logoutUrl}">Sair</a></nav></header>
<main class="container"><h2>Clientes e tutores</h2><div class="grid"><section><table class="tabela"><thead><tr><th>CPF</th><th>Nome</th><th>Usuário</th><th>Telefone</th><th>Email</th><th>Endereço</th><th>Ações</th></tr></thead><tbody>
<c:forEach var="c" items="${clientes}"><tr><td><c:out value="${c.cpf}"/></td><td><c:out value="${c.nome}"/></td><td><c:out value="${c.usuario}"/></td><td><c:out value="${c.telefone}"/></td><td><c:out value="${c.email}"/></td><td><c:out value="${c.endereco}"/></td><td><button type="button" class="btn btn-primario btn-sm" onclick="editar(this)" data-cpf="<c:out value='${c.cpf}'/>" data-nome="<c:out value='${c.nome}'/>" data-usuario="<c:out value='${c.usuario}'/>" data-telefone="<c:out value='${c.telefone}'/>" data-email="<c:out value='${c.email}'/>" data-endereco="<c:out value='${c.endereco}'/>">Editar</button><form action="${deleteUrl}" method="post" style="display:inline"><input type="hidden" name="cpf" value="<c:out value='${c.cpf}'/>"><button class="btn btn-perigo btn-sm" onclick="return confirm('Excluir este cliente? Pets e atendimentos vinculados podem ser removidos.')">Excluir</button></form></td></tr></c:forEach><c:if test="${empty clientes}"><tr><td colspan="7">Nenhum cliente cadastrado.</td></tr></c:if></tbody></table></section>
<form class="card" action="${saveUrl}" method="post" id="clienteForm" autocomplete="off"><input aria-hidden="true" tabindex="-1" style="position:absolute;left:-10000px" name="saved_username" autocomplete="username"><input aria-hidden="true" tabindex="-1" style="position:absolute;left:-10000px" type="password" name="saved_password" autocomplete="current-password"><h3 id="formTitle">Cadastrar cliente</h3><label>CPF</label><input name="cpf" id="cpf" required maxlength="12" autocomplete="off"><label>Nome</label><input name="nome" id="nome" required maxlength="100" autocomplete="off"><label>Usuário</label><input name="novo_usuario" id="novo_usuario" required maxlength="50" autocomplete="off"><label>Senha <small>(obrigatória ao criar; deixe em branco para manter ao editar)</small></label><input name="nova_senha" type="password" id="nova_senha" minlength="4" required autocomplete="new-password"><label>Telefone</label><input name="telefone" id="telefone" autocomplete="off"><label>Email</label><input name="email" id="email" type="email" required autocomplete="off"><label>Endereço</label><input name="endereco" id="endereco" autocomplete="off"><button class="btn btn-sucesso" type="submit">Salvar cliente</button> <button class="btn btn-primario" type="reset" onclick="document.getElementById('formTitle').textContent='Cadastrar cliente';document.getElementById('nova_senha').required=true">Limpar</button></form></div></main>
<script>function editar(b){let f=document.getElementById('clienteForm');for(let k of ['cpf','nome','telefone','email','endereco'])f.elements[k].value=b.dataset[k]||'';f.elements.novo_usuario.value=b.dataset.usuario||'';f.elements.nova_senha.required=false;document.getElementById('formTitle').textContent='Editar cliente';f.scrollIntoView({behavior:'smooth'})}</script></body></html>
