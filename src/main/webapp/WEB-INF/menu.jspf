<header class="navbar">
    <div class="logo">🐾 SmartPet Admin</div>
    <nav>
        <a class="${pageContext.request.requestURI eq pageContext.request.contextPath.concat('/balconista') ? 'active' : ''}"
            href="${pageContext.request.contextPath}/balconista">Balcão</a>
        <a class="${pageContext.request.requestURI eq pageContext.request.contextPath.concat('/veterinario') ? 'active' : ''}"
            href="${pageContext.request.contextPath}/veterinario">Veterinário</a>
        <a class="${pageContext.request.requestURI eq pageContext.request.contextPath.concat('/fila') ? 'active' : ''}"
            href="${pageContext.request.contextPath}/fila">Fila</a>
        <a class="${pageContext.request.requestURI eq pageContext.request.contextPath.concat('/agendamentos') ? 'active' : ''}"
            href="${pageContext.request.contextPath}/agendamentos">Agendamentos</a>
        <span class="nav-sep">|</span>
        <a class="${pageContext.request.requestURI eq pageContext.request.contextPath.concat('/clientes') ? 'active' : ''}"
            href="${pageContext.request.contextPath}/clientes">Clientes</a>
        <a class="${pageContext.request.requestURI eq pageContext.request.contextPath.concat('/pets') ? 'active' : ''}"
            href="${pageContext.request.contextPath}/pets">Pets</a>
        <a class="${pageContext.request.requestURI eq pageContext.request.contextPath.concat('/loja') ? 'active' : ''}"
            href="${pageContext.request.contextPath}/loja">Loja</a>
        <a class="${pageContext.request.requestURI eq pageContext.request.contextPath.concat('/avaliacoes') ? 'active' : ''}"
            href="${pageContext.request.contextPath}/avaliacoes">Avaliações</a>
        <span class="nav-sep">|</span>
        <a href="${pageContext.request.contextPath}/logout">Sair</a>
    </nav>
</header>
