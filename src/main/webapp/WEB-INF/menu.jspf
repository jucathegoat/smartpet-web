<%@ page pageEncoding="UTF-8" %>
<header class="navbar">
    <div class="logo">🐾 SmartPet Admin</div>
    <nav>
        <a class="${menuAtivo eq '/balconista' ? 'active' : ''}"
            href="${pageContext.request.contextPath}/balconista">Balcão</a>
        <a class="${menuAtivo eq '/veterinario' ? 'active' : ''}"
            href="${pageContext.request.contextPath}/veterinario">Veterinário</a>
        <a class="${menuAtivo eq '/fila' ? 'active' : ''}"
            href="${pageContext.request.contextPath}/fila">Fila</a>
        <a class="${menuAtivo eq '/agendamentos' ? 'active' : ''}"
            href="${pageContext.request.contextPath}/agendamentos">Agendamentos</a>
        <span class="nav-sep">|</span>
        <a class="${menuAtivo eq '/clientes' ? 'active' : ''}"
            href="${pageContext.request.contextPath}/clientes">Clientes</a>
        <a class="${menuAtivo eq '/pets' ? 'active' : ''}"
            href="${pageContext.request.contextPath}/pets">Pets</a>
        <a class="${menuAtivo eq '/loja' ? 'active' : ''}"
            href="${pageContext.request.contextPath}/loja">Loja</a>
        <a class="${menuAtivo eq '/avaliacoes' ? 'active' : ''}"
            href="${pageContext.request.contextPath}/avaliacoes">Avaliações</a>
        <span class="nav-sep">|</span>
        <a href="${pageContext.request.contextPath}/logout">Sair</a>
    </nav>
</header>
